NEXT_PUBLIC_WHOP_CHECK_URL=
# Product IDs (prod_...) so the webhook can tell a Seat from a Check
WHOP_SEAT_PRODUCT_ID=
WHOP_CHECK_PRODUCT_ID=

# Protects /api/agents/tick (Vercel Cron sends this as a Bearer token)
CRON_SECRET=
