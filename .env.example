# Copy to .env.local and fill in. Never commit real values.
ANTHROPIC_API_KEY=
EXA_API_KEY=
SOLARI_API_KEY=
TERAC_API_KEY=
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_COMPANY_ID=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
REVERB_TOKEN=
DISCOGS_TOKEN=

# Whop checkout links (public, safe to expose)
